{
  "name": "ui-kit-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run typecheck",
    "storybook": "pnpm --filter docs storybook",
    "changeset": "changeset",
    "release": "turbo run build --filter=@rovia/ui && changeset publish",
    "size": "turbo run size",
    "e2e": "turbo run e2e",
    "registry:build": "node packages/registry/src/cli.mjs",
    "template:sync": "node packages/registry/src/template.mjs",
    "template:check": "node packages/registry/src/template.mjs --check",
    "version-packages": "changeset version && pnpm template:sync"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
