# Copie ce fichier en .env.local et adapte les valeurs.

# URL publique de l'application : SEO (sitemap, robots), image de partage.
# Par défaut : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentification de démonstration (lib/auth.ts). Elle refuse de fonctionner en production,
# sauf avec AUTH_DEMO=true (tests, présentation). Retire cette ligne quand ton fournisseur est branché.
# AUTH_DEMO=true
